{"type": "tool_call", "ts": "2026-05-20T10:56:18.503453+08:00", "agent": "Harper", "tool": "write_file", "args": {"path": "/root/.nanobot/workspace/mario_game/build/web/mario.html", "content": "<!DOCTYPE html>\n<html><head><meta charset=\"utf-8\"><title>Super Mario Bros</title>\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nbody{background:#000;display:flex;flex-direction:column;justify-content:flex-start;align-items:center;height:100dvh;overflow:hidden;touch-action:none;user-select:none;-webkit-user-select:none}\ncanvas{image-rendering:pixelated;border:2px solid #333;max-width:100vw;width:auto;height:auto;max-height:calc(100dvh - 100px);object-fit:contain}\n#info{color:#fff;font:12px monospace;text-align:center;padding:2px}\n#controls{display:flex;justify-content:space-between;width:100%;max-width:512px;padding:4px 12px;position:fixed;bottom:0;left:50%;transform:translateX(-50%);z-index:10}\n#dpad{display:flex;gap:6px}#actions{display:flex;gap:6px}\n.tbtn{width:56px;height:56px;border-radius:50%;border:2px solid rgba(255,255,255,0.5);background:rgba(255,255,255,0.15);color:#fff;font-size:20px;display:flex;align-items:center;justify-content:center;-webkit-tap-highlight-color:transparent}\n.tbtn:active,.tbtn.active{background:rgba(255,255,255,0.4)}\n.tbtn-jump{width:70px;height:70px;font-size:13px;font-weight:bold}.tbtn-r{width:44px;height:44px;font-size:11px}\n</style>\n</head><body>\n<div id=\"info\">← → 移动 | 空格/触屏 跳跃 | R 重开</div>\n<canvas id=\"c\" width=\"512\" height=\"480\"></canvas>\n<div id=\"controls\">\n  <div id=\"dpad\">\n    <button class=\"tbtn\" id=\"btn-left\">◀</button>\n    <button class=\"tbtn\" id=\"btn-right\">▶</button>\n  </div>\n  <div id=\"actions\">\n    <button class=\"tbtn tbtn-r\" id=\"btn-r\">R</button>\n    <button class=\"tbtn tbtn-jump\" id=\"btn-jump\">JUMP</button>\n  </div>\n</div>\n<script>\nconst canvas=document.getElementById('c'),ctx=canvas.getContext('2d');\nconst T=32,COLS=16,ROWS=15,W=COLS*T,H=ROWS*T;\ncanvas.width=W;canvas.height=H;\nconst keys={};\ndocument.addEventListener('keydown',e=>{keys[e.code]=true;if(['Space','ArrowUp','ArrowDown'].includes(e.code))e.preventDefault()});\ndocument.addEventListener('keyup',e=>{keys[e.code]=false});\nfunction bindTouch(id,code){\n  const el=document.getElementById(id);if(!el)return;\n  const on=e=>{e.preventDefault();keys[code]=true;el.classList.add('active')};\n  const off=e=>{e.preventDefault();keys[code]=false;el.classList.remove('active')};\n  el.addEventListener('touchstart',on,{passive:false});el.addEventListener('touchend',off,{passive:false});\n  el.addEventListener('touchcancel',off,{passive:false});el.addEventListener('mousedown',on);\n  el.addEventListener('mouseup',off);el.addEventListener('mouseleave',off);\n}\nbindTouch('btn-left','ArrowLeft');bindTouch('btn-right','ArrowRight');\nbindTouch('btn-jump','Space');bindTouch('btn-r','KeyR');\ncanvas.addEventListener('touchstart',e=>{e.preventDefault();keys['Space']=true},{passive:false});\ncanvas.addEventListener('touchend',e=>{e.preventDefault();keys['Space']=false},{passive:false});\n\n// ─── Level: 60 columns wide, 15 rows ───\nconst LEVEL1=[\n\"  ?         ?    ?             ?         ?     ?      \",\n\"                                                      \",\n\"                                                      \",\n\"                                                      \",\n\"         ?                                            \",\n\"                                                      \",\n\"              B   B?B                                 \",\n\"                                                      \",\n\"                   ?                                  \",\n\"                        BBB  BBB                      \",\n\"                     BB      B    B B B?              \",\n\"           B                     B B  B B             \",\n\"  P                  E            B E   B      E  F   \",\n\"BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB\",\n\"                                                      \",\n];\n\n// ─── Physics constants ───\nconst GRAVITY=0.45;\nconst JUMP_VEL=-8.5;\nconst JUMP_HOLD_VEL=-1.2;    // per frame while holding jump\nconst MAX_JUMP_HOLD=12;       // max frames to hold\nconst MOVE_ACCEL=0.4;\nconst MOVE_MAX=3.0;\nconst FRICTION=0.82;\nconst COYOTE_FRAMES=6;\n\nlet player,coins,score,enemies,particles,gameOver,won,cameraX,clouds,mountains,lastTime;\nlet jumpHoldCounter=0;\nlet coyoteCounter=0;\n\n// ─── Scenery ───\nfunction generateScenery(){\n  clouds=[];mountains=[];\n  const levelW=LEVEL1[0].length*T;\n  for(let i=0;i<8;i++){\n    clouds.push({x:Math.random()*levelW,y:Math.random()*80+10,w:48+Math.random()*64,h:24});\n  }\n  for(let i=0;i<4;i++){\n    mountains.push({x:Math.random()*levelW,y:200+Math.random()*60,w:80+Math.random()*80,h:40+Math.random()*60});\n  }\n}\n\nfunction parseLevel(){\n  let map=[];coins=[];enemies=[];particles=[];jumpHoldCounter=0;coyoteCounter=0;\n  for(let r=0;r<ROWS;r++){\n    let row=[];let line=LEVEL1[r]||' '.repeat(COLS*4);\n    for(let c=0;c<line.length;c++){\n      let ch=line[c];\n      if(ch==='P'){player={x:c*T,y:r*T,vx:0,vy:0,w:T-4,h:T,onGround:false,dir:1,frame:0,prevY:r*T};row.push(' ')}\n      else if(ch==='E'){enemies.push({x:c*T,y:r*T+4,vx:-0.8,vy:0,w:T,h:T-4,alive:true,frame:0});row.push(' ')}\n      else if(ch==='F'){enemies.push({x:c*T,y:r*T+4,vx:0.8,vy:0,w:T,h:T-4,alive:true,frame:0});row.push(' ')}\n      else if(ch==='$'){coins.push({x:c*T+8,y:r*T+8,w:16,h:16,collected:false,angle:0});row.push(' ')}\n      else row.push(ch);\n    }\n    map.push(row);\n  }\n  return map;\n}\n\nlet map;\nfunction init(){\n  map=parseLevel();score=0;gameOver=false;won=false;cameraX=0;lastTime=performance.now();\n  generateScenery();\n  for(let r=0;r<ROWS;r++)for(let c=0;c<(map[r]||[]).length;c++)\n    if(map[r][c]==='?'){coins.push({x:c*T+8,y:r*T+8,w:16,h:16,collected:false,angle:0})};\n}\ninit();\n\nfunction getTile(r,c){\n  if(r<0||r>=ROWS)return 'B';\n  if(c<0||c>=(map[r]||[]).length)return ' ';\n  return map[r][c];\n}\nfunction isSolid(r,c){let t=getTile(r,c);return t==='B'||t==='?'}\nfunction rectOverlap(a,b){return a.x<b.x+b.w&&a.x+a.w>b.x&&a.y<b.y+b.h&&a.y+a.h>b.y}\n\nfunction updatePlayer(){\n  if(gameOver||won)return;\n  let p=player;\n  \n  // ── Horizontal movement (acceleration-based) ──\n  if(keys['ArrowLeft']){p.vx-=MOVE_ACCEL;if(p.vx<-MOVE_MAX)p.vx=-MOVE_MAX;p.dir=-1}\n  else if(keys['ArrowRight']){p.vx+=MOVE_ACCEL;if(p.vx>MOVE_MAX)p.vx=MOVE_MAX;p.dir=1}\n  else p.vx*=FRICTION;\n  if(Math.abs(p.vx)<0.01)p.vx=0;\n\n  // ── Coyote time + variable jump ──\n  if(p.onGround)coyoteCounter=COYOTE_FRAMES;\n  else if(coyoteCounter>0)coyoteCounter--;\n  \n  const jumpPressed=keys['Space']||keys['ArrowUp'];\n  if(jumpPressed&&coyoteCounter>0){\n    p.vy=JUMP_VEL;p.onGround=false;coyoteCounter=0;\n    jumpHoldCounter=0;\n  }\n  // Variable jump: hold to jump higher\n  if(jumpPressed&&!p.onGround&&jumpHoldCounter<MAX_JUMP_HOLD&&p.vy<0){\n    p.vy+=JUMP_HOLD_VEL;\n    jumpHoldCounter++;\n  }\n  // Release early = cut jump short\n  if(!jumpPressed&&jumpHoldCounter>0)jumpHoldCounter=MAX_JUMP_HOLD;\n  \n  p.vy+=GRAVITY;\n  if(p.vy>10)p.vy=10;\n\n  // ── Horizontal collision ──\n  p.x+=p.vx;\n  let left=Math.floor((p.x+2)/T),right=Math.floor((p.x+p.w-2)/T);\n  let top=Math.floor(p.y/T),bot=Math.floor((p.y+p.h-1)/T);\n  for(let r=top;r<=bot;r++){\n    if(isSolid(r,left)){p.x=(left+1)*T-2;p.vx=0}\n    if(isSolid(r,right)){p.x=right*T-p.w+2;p.vx=0}\n  }\n\n  // ── Vertical collision ──\n  p.y+=p.vy;\n  p.onGround=false;\n  left=Math.floor((p.x+2)/T);right=Math.floor((p.x+p.w-2)/T);\n  top=Math.floor(p.y/T);bot=Math.floor((p.y+p.h-1)/T);\n  if(p.vy>=0){\n    for(let c=left;c<=right;c++){\n      if(isSolid(bot,c)){p.y=bot*T-p.h;p.vy=0;p.onGround=true;jumpHoldCounter=0}\n    }\n  }else{\n    for(let c=left;c<=right;c++){\n      if(isSolid(top,c)){p.y=(top+1)*T;p.vy=0;jumpHoldCounter=MAX_JUMP_HOLD;\n        if(map[top]&&map[top][c]==='?'){map[top][c]=' ';score+=100;\n          particles.push({x:c*T+16,y:top*T,vx:0,vy:-3,life:30,text:'+100'})}\n      }\n    }\n  }\n\n  // ── Collect coins ──\n  coins.forEach(c=>{if(!c.collected&&rectOverlap(p,c)){c.collected=true;score+=200;\n    particles.push({x:c.x,y:c.y,vx:0,vy:-2,life:30,text:'+200'})}});\n\n  // ── Enemy collision ──\n  enemies.forEach(e=>{\n    if(!e.alive)return;\n    if(rectOverlap(p,{x:e.x+2,y:e.y+2,w:e.w-4,h:e.h-4})){\n      if(p.vy>0&&p.y+p.h-8<e.y+e.h/2){e.alive=false;p.vy=-6;score+=500;\n        particles.push({x:e.x,y:e.y,vx:0,vy:-2,life:30,text:'+500'})}\n      else{gameOver=true}\n    }\n  });\n\n  // ── Win/lose conditions ──\n  if(p.x>LEVEL1[0].length*T-T*2)won=true;\n  if(p.y>ROWS*T+64)gameOver=true;\n  p.frame=(p.frame+0.15)%2;\n  p.prevY=p.y;\n}\n\nfunction updateEnemies(){\n  enemies.forEach(e=>{\n    if(!e.alive)return;\n    e.x+=e.vx;\n    e.y+=e.vy;e.vy+=GRAVITY;\n    // Floor collision\n    let r=Math.floor((e.y+e.h)/T),c=Math.floor((e.x+e.w/2)/T);\n    if(isSolid(r,c)){e.y=r*T-e.h;e.vy=0}\n    // Edge detection: turn at ledges\n    let nextC=Math.floor((e.x+(e.vx>0?e.w:0))/T);\n    if(!isSolid(r+1,nextC))e.vx*=-1;\n    // Wall detection\n    let wallC=Math.floor((e.x+(e.vx>0?e.w:-0))/T);\n    let wallR=Math.floor((e.y+4)/T);\n    if(isSolid(wallR,wallC))e.vx*=-1;\n    // Fall off screen\n    if(e.y>ROWS*T+64)e.alive=false;\n    e.frame=(e.frame+0.05)%2;\n  });\n}\n\nfunction updateParticles(){\n  particles=particles.filter(p=>{p.x+=p.vx;p.y+=p.vy;p.vy+=0.1;p.life--;return p.life>0});\n}\n\n// ─── Drawing ───\nfunction drawBackground(){\n  ctx.fillStyle='#5C94FC';ctx.fillRect(0,0,W,H);\n  cameraX=Math.max(0,Math.min(player.x-W/2,LEVEL1[0].length*T-W));\n  \n  // Mountains (parallax slow)\n  mountains.forEach(m=>{\n    let sx=m.x-cameraX*0.3;\n    sx=((sx%(LEVEL1[0].length*T*2))+LEVEL1[0].length*T*2)%(LEVEL1[0].length*T*2)-200;\n    ctx.fillStyle='#5A7A3A';\n    ctx.beginPath();ctx.moveTo(sx,m.y+m.h);\n    ctx.lineTo(sx+m.w/2,m.y);ctx.lineTo(sx+m.w,m.y+m.h);ctx.closePath();ctx.fill();\n    ctx.fillStyle='#6B8E3B';\n    ctx.beginPath();ctx.moveTo(sx+10,m.y+m.h);\n    ctx.lineTo(sx+m.w/2+5,m.y+10);ctx.lineTo(sx+m.w-10,m.y+m.h);ctx.closePath();ctx.fill();\n  });\n  \n  // Clouds (parallax slow)\n  clouds.forEach(c=>{\n    let sx=c.x-cameraX*0.15;\n    sx=((sx%(LEVEL1[0].length*T*3))+LEVEL1[0].length*T*3)%(LEVEL1[0].length*T*3)-100;\n    ctx.fillStyle='rgba(255,255,255,0.8)';\n    ctx.beginPath();ctx.ellipse(sx,c.y,c.w/2,c.h/2,0,0,Math.PI*2);ctx.fill();\n    ctx.beginPath();ctx.ellipse(sx+c.w*0.3,c.y-c.h*0.2,c.w*0.4,c.h*0.6,0,0,Math.PI*2);ctx.fill();\n    ctx.beginPath();ctx.ellipse(sx-c.w*0.25,c.y-c.h*0.1,c.w*0.35,c.h*0.5,0,0,Math.PI*2);ctx.fill();\n  });\n}\n\nfunction drawTile(x,y,type){\n  let sx=x-cameraX,sy=y;\n  if(sx<-T||sx>W+32)return;\n  if(type==='B'){\n    ctx.fillStyle='#8B4513';ctx.fillRect(sx,sy,T,T);\n    ctx.fillStyle='#A0522D';ctx.fillRect(sx+2,sy+2,T-4,T-4);\n    ctx.fillStyle='#8B4513';ctx.fillRect(sx+T/2-1,sy,2,T);\n  }else if(type==='?'){\n    const bounce=Math.sin(Date.now()/300)*1;\n    ctx.fillStyle='#FFD700';ctx.fillRect(sx,sy+bounce,T,T);\n    ctx.fillStyle='#FFA500';ctx.fillRect(sx+3,sy+3+bounce,T-6,T-6);\n    ctx.fillStyle='#FFF';ctx.font='bold 18px monospace';ctx.fillText('?',sx+10,sy+22+bounce);\n  }\n}\n\nfunction drawPlayer(){\n  let p=player,sx=p.x-cameraX,sy=p.y;\n  const bounce=p.onGround?Math.abs(Math.sin(p.frame*Math.PI))*2:0;\n  // Hat\n  ctx.fillStyle='#FF0000';ctx.fillRect(sx+4,sy-2+bounce,24,10);\n  // Face\n  ctx.fillStyle='#FFCC99';ctx.fillRect(sx+4,sy+8+bounce,24,8);\n  ctx.fillStyle='#000';ctx.fillRect(sx+(p.dir>0?20:8),sy+10+bounce,4,3);\n  // Body\n  ctx.fillStyle='#E00000';ctx.fillRect(sx+3,sy+16+bounce,26,12);\n  // Arms\n  ctx.fillStyle='#FFCC99';ctx.fillRect(sx-2,sy+18+bounce,6,6);\n  ctx.fillRect(sx+28,sy+18+bounce,6,6);\n  // Legs\n  const legAnim=p.onGround?Math.sin(p.frame*Math.PI*2)*3:2;\n  ctx.fillStyle='#0000FF';\n  ctx.fillRect(sx+4,sy+28+bounce,10,6+legAnim);\n  ctx.fillRect(sx+18,sy+28+bounce,10,6-legAnim);\n  // Shoes\n  ctx.fillStyle='#8B4513';\n  ctx.fillRect(sx+3,sy+34+bounce,12,3);\n  ctx.fillRect(sx+17,sy+34+bounce,12,3);\n}\n\nfunction drawEnemy(e){\n  if(!e.alive)return;\n  let sx=e.x-cameraX,sy=e.y;\n  if(sx<-T||sx>W+32)return;\n  // Body\n  ctx.fillStyle='#8B4513';ctx.fillRect(sx+2,sy,28,10);\n  ctx.fillRect(sx,sy+8,32,16);\n  ctx.fillStyle='#DEB887';ctx.fillRect(sx+4,sy+22,24,10);\n  // Eyes\n  ctx.fillStyle='#FFF';ctx.fillRect(sx+6,sy+10,8,6);\n  ctx.fillRect(sx+18,sy+10,8,6);\n  ctx.fillStyle='#000';ctx.fillRect(sx+(e.vx>0?10:8),sy+12,4,4);\n  ctx.fillRect(sx+(e.vx>0?22:20),sy+12,4,4);\n  // Feet\n  ctx.fillStyle='#8B4513';\n  ctx.fillRect(sx+2,sy+28,12,4);\n  ctx.fillRect(sx+18,sy+28,12,4);\n}\n\nfunction drawCoin(c){\n  if(c.collected)return;\n  let sx=c.x-cameraX,sy=c.y-cameraY||0;\n  const scaleX=Math.abs(Math.cos(Date.now()/200+c.x));\n  ctx.fillStyle='#FFD700';\n  ctx.save();\n  ctx.translate(sx+8,sy+8);\n  ctx.scale(scaleX,1);\n  ctx.beginPath();ctx.arc(0,0,6,0,Math.PI*2);ctx.fill();\n  ctx.fillStyle='#FFA500';\n  ctx.beginPath();ctx.arc(0,0,3,0,Math.PI*2);ctx.fill();\n  ctx.restore();\n}\n\nfunction drawHUD(){\n  ctx.fillStyle='rgba(0,0,0,0.5)';ctx.fillRect(0,0,W,36);\n  ctx.fillStyle='#FFF';ctx.font='bold 14px monospace';\n  ctx.fillText('MARIO',8,14);\n  ctx.fillText(String(score).padStart(6,'0'),8,30);\n  ctx.fillText('COINS x'+coins.filter(c=>c.collected).length,160,14);\n  ctx.fillText('WORLD 1-1',280,14);\n}\n\nfunction draw(){\n  drawBackground();\n  // Tiles (only visible)\n  const startC=Math.max(0,Math.floor(cameraX/T)-1);\n  const endC=Math.min(LEVEL1[0].length,startC+COLS+2);\n  for(let r=0;r<ROWS;r++)for(let c=startC;c<endC;c++)\n    if(map[r]&&map[r][c])drawTile(c*T,r*T,map[r][c]);\n  \n  coins.forEach(drawCoin);\n  enemies.forEach(drawEnemy);\n  if(!gameOver)drawPlayer();\n  \n  particles.forEach(p=>{\n    ctx.fillStyle='#FFF';ctx.font='bold 12px monospace';\n    ctx.fillText(p.text,p.x-cameraX,p.y);\n  });\n  \n  drawHUD();\n  \n  if(gameOver){\n    ctx.fillStyle='rgba(0,0,0,0.7)';ctx.fillRect(0,0,W,H);\n    ctx.fillStyle='#FF4444';ctx.font='bold 32px monospace';ctx.textAlign='center';\n    ctx.fillText('GAME OVER',W/2,H/2-20);\n    ctx.fillStyle='#FFF';ctx.font='16px monospace';\n    ctx.fillText('Score: '+score,W/2,H/2+20);\n    ctx.fillText('Press R to Restart',W/2,H/2+50);\n    ctx.textAlign='left';\n  }\n  if(won){\n    ctx.fillStyle='rgba(0,0,0,0.6)';ctx.fillRect(0,0,W,H);\n    ctx.fillStyle='#FFD700';ctx.font='bold 32px monospace';ctx.textAlign='center';\n    ctx.fillText('YOU WIN!',W/2,H/2-20);\n    ctx.fillStyle='#FFF';ctx.font='20px monospace';\n    ctx.fillText('Score: '+score,W/2,H/2+20);\n    ctx.fillText('Press R',W/2,H/2+50);\n    ctx.textAlign='left';\n  }\n}\n\nfunction loop(time){\n  if(keys['KeyR']){init();keys['KeyR']=false}\n  updatePlayer();updateEnemies();updateParticles();draw();\n  requestAnimationFrame(loop);\n}\nloop();\n</script>\n</body></html>\n"}}
